@startuml Vinstore-Activity-Checkout
' =====================================================================
'  ACTIVITY DIAGRAM - Checkout & Pembayaran (Midtrans)
' =====================================================================
title Activity Diagram - Checkout & Pembayaran Produk

|Pembeli|
start
:Membuka halaman detail produk;
:Menekan tombol Beli / Checkout;

|Sistem|
:Sinkronisasi status Tebak Harga (PriceGuessService::sync);
if (Produk sudah di-approve admin?) then (tidak)
  |Pembeli|
  :Menerima pesan "Produk belum disetujui";
  stop
else (ya)
endif

if (Produk milik toko sendiri?) then (ya)
  |Pembeli|
  :Menerima pesan "Tidak bisa membeli produk sendiri";
  stop
else (tidak)
endif

if (Produk Tebak Harga & belum boleh dibeli?) then (ya)
  |Pembeli|
  :Menerima pesan status tebak harga;
  stop
else (tidak)
endif

|Pembeli|
:Mengisi jumlah (quantity);
:Submit checkout;

|Sistem|
:Mulai transaksi DB (lockForUpdate produk);
if (Stok mencukupi?) then (tidak)
  :Rollback transaksi;
  |Pembeli|
  :Menerima pesan "Stok tidak mencukupi";
  stop
else (ya)
endif

|Sistem|
:Hitung total harga;
:Kurangi stok produk;
:Buat Order (status=Waiting, payment_status=pending);
:Set payment_reference = public_id order;

|Midtrans|
:createSnapTransaction (token + redirect_url);

|Sistem|
:Simpan snap_token & redirect_url ke Order;
:Commit transaksi;
:Redirect ke halaman pembayaran Midtrans;

|Pembeli|
:Melakukan pembayaran di Midtrans;

|Midtrans|
:Mengirim notifikasi pembayaran (webhook);

|Sistem|
:Verifikasi signature & map status pembayaran;
if (Pembayaran berhasil (paid)?) then (ya)
  :Set payment_status=paid, paid_at=now;
else (gagal/expired/cancel)
  :Set status=Cancelled;
  :Kembalikan stok (restoreReservedStock);
endif
:Perbarui Order;

|Pembeli|
:Melihat status pesanan / invoice;
stop

@enduml
