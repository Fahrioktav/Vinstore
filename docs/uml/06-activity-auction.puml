@startuml Vinstore-Activity-Auction
' =====================================================================
'  ACTIVITY DIAGRAM - Lelang Barang Antik
'  Alur: seller ajukan lelang -> admin approve -> user bid -> selesai -> order Midtrans
' =====================================================================
title Activity Diagram - Lelang Barang Antik

|Penjual|
start
:Membuka form tambah lelang;
:Mengisi nama, deskripsi, foto,\nharga awal, minimal bid,\nwaktu mulai dan selesai;
:Submit barang lelang;

|Sistem|
:Validasi data lelang;
if (Data valid dan seller memiliki toko?) then (tidak)
  |Penjual|
  :Menerima pesan error;
  stop
else (ya)
endif

|Sistem|
:Simpan lelang\napproval_status=pending,\nstatus=pending;

|Admin|
:Membuka daftar pengajuan lelang;
:Meninjau data barang lelang;
if (Lelang disetujui?) then (tidak)
  :Reject + isi alasan;
  |Sistem|
  :Set approval_status=rejected;
  :Set status=cancelled;
  |Penjual|
  :Menerima informasi penolakan;
  stop
else (ya)
endif

|Sistem|
if (Waktu selesai sudah lewat?) then (ya)
  |Admin|
  :Menerima pesan error;
  stop
else (tidak)
endif
:Set approval_status=approved;
if (Waktu mulai masih nanti?) then (ya)
  :Set status=scheduled;
else (tidak)
  :Set status=active;
endif

|Pembeli|
:Membuka halaman lelang;

|Sistem|
:Sinkronisasi status lelang;
if (Lelang aktif?) then (tidak)
  |Pembeli|
  :Melihat status scheduled/ended;
  stop
else (ya)
endif

|Pembeli|
:Mengisi nominal bid;
:Submit penawaran;

|Sistem|
:Lock data lelang;
if (Pembeli adalah pemilik toko?) then (ya)
  |Pembeli|
  :Menerima pesan tidak boleh bid\nbarang sendiri;
  stop
else (tidak)
endif

if (Nominal >= harga saat ini + minimal kenaikan?) then (tidak)
  |Pembeli|
  :Menerima pesan minimal bid;
  stop
else (ya)
endif

|Sistem|
:Simpan AuctionBid;
:Update current_price dan bids_count;

while (Waktu lelang belum habis?) is (ya)
  |Pembeli|
  :User lain dapat mengajukan bid;
  |Sistem|
  :Update harga tertinggi;
endwhile (tidak)

|Sistem|
:Finalisasi lelang;
if (Ada bid tertinggi?) then (tidak)
  :Set status=ended tanpa pemenang;
  |Penjual|
  :Dapat mengajukan ulang lelang;
  stop
else (ya)
endif

|Sistem|
:Set winner_id;
:Buat Order untuk pemenang\nstatus=Waiting,\npayment_status=pending,\npayment_method=midtrans;
:Set payment_reference=public_id order;

|Pemenang|
:Membuka pembayaran lelang;

|Sistem|
:Buat transaksi Midtrans;
:Redirect ke halaman pembayaran;

|Midtrans|
:Memproses pembayaran;
:Mengirim webhook pembayaran;

|Sistem|
:Update status pembayaran order;

|Pemenang|
:Melihat status pembayaran lelang;
stop

@enduml
