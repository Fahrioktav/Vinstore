@startuml Vinstore-ClassDiagram
' =====================================================================
'  CLASS DIAGRAM ARSITEKTUR - VINSTORE
'  Mencakup: Model (domain), Controller, dan Service (arsitektur MVC Laravel)
' =====================================================================
skinparam classAttributeIconSize 0
skinparam linetype ortho
title Class Diagram Arsitektur - Sistem Vinstore

' ============================= MODELS ===============================
package "Models (Eloquent)" {

  class User {
    - id : bigint
    - public_id : string
    - username : string
    - first_name : string
    - last_name : string
    - email : string
    - google_id : string
    - phone : string
    - address : string
    - photo : string
    - password : string
    - role : string
    --
    + isAdmin() : bool
    + isSeller() : bool
    + isValidator() : bool
    + store() : Store
    + orders() : Order[]
    + cartItems() : Cart[]
    + auctionBids() : AuctionBid[]
    + wonAuctions() : Auction[]
    + refundRequests() : RefundRequest[]
  }

  class Store {
    - id : bigint
    - public_id : string
    - user_id : bigint
    - store_name : string
    - category : string
    - description : text
    - location : string
    - latitude : float
    - longitude : float
    - photo : string
    - available_balance : decimal
    - withdrawn_balance : decimal
    --
    + user() : User
    + products() : Product[]
    + auctions() : Auction[]
    + withdrawalRequests() : WithdrawalRequest[]
  }

  class Category {
    - id : bigint
    - public_id : string
    - name : string
    - image : string
  }

  class Product {
    - id : bigint
    - public_id : string
    - store_id : bigint
    - name : string
    - stock : int
    - price : decimal
    - category : string
    - description : text
    - image : string
    - certificate : string
    - is_barterable : bool
    - sale_type : string
    - approval_status : string
    - validated_at : datetime
    - validated_by : bigint
    - approved_at : datetime
    - approved_by : bigint
    - rejection_reason : text
    - guess_status : string
    - guess_winner_id : bigint
    - winner_priority_until : datetime
    --
    + isTebakHarga() : bool
    + isGuessingOpen() : bool
    + isPurchasableBy(user) : bool
    + shouldHidePriceFor(user) : bool
    + maskRealPriceFor(user) : Product
    + scopeApproved()
    + scopeBarterable()
  }

  class Cart {
    - id : bigint
    - public_id : string
    - user_id : bigint
    - product_id : bigint
    - quantity : int
  }

  class Order {
    - id : bigint
    - public_id : string
    - user_id : bigint
    - product_id : bigint
    - auction_id : bigint
    - store_id : bigint
    - quantity : int
    - price : decimal
    - status : string
    - payment_reference : string
    - payment_status : string
    - payment_method : string
    - snap_token : string
    - paid_at : datetime
    --
    + restoreReservedStock() : void
    + releaseSellerFunds() : void
    + product() : Product
    + auction() : Auction
    + refundRequest() : RefundRequest
  }

  class Auction {
    - id : bigint
    - public_id : string
    - store_id : bigint
    - winner_id : bigint
    - name : string
    - starting_price : decimal
    - min_increment : decimal
    - current_price : decimal
    - bids_count : int
    - approval_status : string
    - status : string
    - starts_at : datetime
    - ends_at : datetime
    --
    + isActive() : bool
    + bids() : AuctionBid[]
    + highestBid() : AuctionBid
    + winner() : User
    + order() : Order
  }

  class AuctionBid {
    - id : bigint
    - auction_id : bigint
    - user_id : bigint
    - amount : decimal
  }

  class PriceGuess {
    - id : bigint
    - product_id : bigint
    - user_id : bigint
    - amount : decimal
  }

  class BarterRequest {
    - id : bigint
    - public_id : string
    - requester_store_id : bigint
    - responder_store_id : bigint
    - offered_product_id : bigint
    - requested_product_id : bigint
    - additional_cash : decimal
    - status : string
    --
    + scopePending()
  }

  class RefundRequest {
    - id : bigint
    - public_id : string
    - order_id : bigint
    - user_id : bigint
    - reason : text
    - proof_image : string
    - status : string
    - reviewed_by : bigint
  }

  class WithdrawalRequest {
    - id : bigint
    - public_id : string
    - store_id : bigint
    - amount : decimal
    - bank_name : string
    - account_number : string
    - account_holder : string
    - status : string
    - reviewed_by : bigint
  }

  class Contact {
    - id : bigint
    - public_id : string
    - user_id : bigint
    - name : string
    - email : string
    - subject : string
    - message : text
    - status : string
    - admin_reply : text
  }

  class SupportMessage {
    - id : bigint
    - user_id : bigint
    - sender_role : string
    - body : text
  }
}

' ====================== RELASI ANTAR MODEL ==========================
User "1" -- "0..1" Store : memiliki >
Store "1" -- "*" Product : menjual >
Store "1" -- "*" Auction : menyelenggarakan >
Store "1" -- "*" WithdrawalRequest : mengajukan >
User "1" -- "*" Order : memesan >
User "1" -- "*" Cart : memiliki >
User "1" -- "*" AuctionBid : menawar >
User "1" -- "*" PriceGuess : menebak >
User "1" -- "*" RefundRequest : mengajukan >
User "1" -- "*" SupportMessage : mengirim >
Product "1" -- "*" Cart : tercantum >
Product "1" -- "*" Order : dipesan >
Product "1" -- "*" PriceGuess : ditebak >
Auction "1" -- "*" AuctionBid : menerima >
Auction "1" -- "0..1" Order : menghasilkan >
Order "1" -- "0..1" RefundRequest : dirujuk >
BarterRequest "*" -- "1" Store : pengaju >
BarterRequest "*" -- "1" Product : produk ditawarkan >
Contact "*" -- "0..1" User : dikirim oleh >

note right of Category
  Kategori produk disediakan admin.
  Pada implementasi saat ini nilai kategori
  produk disimpan sebagai teks nama kategori,
  bukan foreign key category_id.
end note

' ============================ CONTROLLERS ===========================
package "Controllers" {
  class OrderController {
    + showCheckout(product)
    + processCheckout(req, product)
    + checkoutFromCart()
    + userOrders()
    + cancelOrder(id)
    + updateStatus(req, id)
    + showInvoice(id)
  }
  class ProductController
  class AuctionController
  class BarterController
  class PriceGuessController
  class ValidatorController
  class RefundRequestController
  class WithdrawalRequestController
  class SupportController
  class CartController
  class StoreController
  class MidtransNotificationController {
    + __invoke(request)
  }
}

' ============================= SERVICES =============================
package "Services" {
  class MidtransService {
    + createSnapTransaction(ref, amount, user, items) : array
    + getTransactionStatus(ref) : array
    + isValidSignature(payload) : bool
    + mapPaymentStatus(trxStatus, fraudStatus) : string
  }
  class PriceGuessService {
    + sync() : void
  }
}

' =================== KETERGANTUNGAN (DEPENDENCY) ====================
OrderController ..> MidtransService : <<use>>
OrderController ..> PriceGuessService : <<use>>
OrderController ..> Order
OrderController ..> Product
OrderController ..> Cart
MidtransNotificationController ..> MidtransService : <<use>>
MidtransNotificationController ..> Order
PriceGuessController ..> PriceGuess
PriceGuessController ..> Product
AuctionController ..> Auction
AuctionController ..> AuctionBid
BarterController ..> BarterRequest
ValidatorController ..> Product
RefundRequestController ..> RefundRequest
WithdrawalRequestController ..> WithdrawalRequest
SupportController ..> SupportMessage
CartController ..> Cart
StoreController ..> Store

@enduml
