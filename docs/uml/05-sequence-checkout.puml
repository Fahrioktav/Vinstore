@startuml Vinstore-Sequence-Checkout
' =====================================================================
'  SEQUENCE DIAGRAM - Checkout Produk & Pembayaran Midtrans
' =====================================================================
title Sequence Diagram - Checkout & Pembayaran Produk

actor "Pembeli" as User
participant ":OrderController" as OC
participant ":PriceGuessService" as PGS
database "DB" as DB
participant ":Product" as Prod
participant ":Order" as Order
participant ":MidtransService" as Midtrans
participant ":MidtransNotificationController" as MNC
participant "Midtrans\nGateway" as Gateway

autonumber

User -> OC : processCheckout(request, product)
activate OC

OC -> PGS : sync()
activate PGS
PGS --> OC : status tebak harga terbaru
deactivate PGS

OC -> Prod : isPurchasableBy(user)
activate Prod
Prod --> OC : true / false
deactivate Prod

alt produk milik sendiri / belum bisa dibeli
    OC --> User : back() with error
end

OC -> DB : beginTransaction()
activate DB

OC -> Prod : lockForUpdate()->firstOrFail()
activate Prod
Prod --> OC : product (terkunci)
deactivate Prod

alt stok tidak mencukupi
    OC -> DB : rollBack()
    OC --> User : back() with error "Stok tidak cukup"
else stok cukup
    OC -> Prod : kurangi stock & save()
    OC -> Order : create(status=Waiting, payment_status=pending)
    activate Order
    Order --> OC : order (public_id)
    deactivate Order

    OC -> Order : update(payment_reference = public_id)

    OC -> Midtrans : createSnapTransaction(ref, total, user, items)
    activate Midtrans
    Midtrans -> Gateway : POST /snap (HTTP)
    activate Gateway
    Gateway --> Midtrans : {token, redirect_url}
    deactivate Gateway
    Midtrans --> OC : {token, redirect_url}
    deactivate Midtrans

    OC -> Order : update(snap_token, snap_redirect_url)
    OC -> DB : commit()
    deactivate DB

    OC --> User : redirect ke redirect_url (Midtrans)
end
deactivate OC

== Pembayaran ==
User -> Gateway : Melakukan pembayaran
activate Gateway
Gateway -> Gateway : Memproses pembayaran
Gateway -> MNC : POST /midtrans/notification (webhook)
deactivate Gateway
activate MNC

MNC -> Midtrans : isValidSignature(payload)
activate Midtrans
Midtrans --> MNC : valid
MNC -> Midtrans : mapPaymentStatus(trxStatus, fraudStatus)
Midtrans --> MNC : "paid" / "cancelled" / ...
deactivate Midtrans

alt pembayaran berhasil (paid)
    MNC -> Order : update(payment_status=paid, paid_at=now)
else gagal / expired / cancel
    MNC -> Order : update(status=Cancelled)
    MNC -> Order : restoreReservedStock()
end
MNC --> Gateway : HTTP 200 OK
deactivate MNC

User -> OC : userOrders()
activate OC
OC -> Midtrans : getTransactionStatus(ref) (sinkronisasi)
OC --> User : daftar pesanan + status terbaru
deactivate OC

@enduml
