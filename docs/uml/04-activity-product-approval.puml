@startuml Vinstore-Activity-ProductApproval
' =====================================================================
'  ACTIVITY DIAGRAM - Pengajuan & Validasi Produk (2 Tahap)
'  Alur: pending_validator -> pending_admin -> approved / rejected
' =====================================================================
title Activity Diagram - Pengajuan & Validasi Produk Barang Antik

|Penjual|
start
:Mengisi form produk + unggah sertifikat keaslian;
:Submit produk;

|Sistem|
:Simpan produk (approval_status = pending_validator);

|Validator|
:Membuka daftar produk pending_validator;
:Memeriksa keaslian barang antik & sertifikat;
if (Produk asli / valid?) then (ya)
  :Approve produk;
  |Sistem|
  :Set approval_status = pending_admin;
  :Catat validated_by & validated_at;
else (tidak)
  |Validator|
  :Reject + isi alasan;
  |Sistem|
  :Set approval_status = rejected;
  :Simpan rejection_reason;
  |Penjual|
  :Menerima notifikasi penolakan;
  stop
endif

|Admin|
:Membuka daftar produk pending_admin;
:Meninjau produk yang sudah divalidasi;
if (Disetujui?) then (ya)
  :Approve produk;
  |Sistem|
  :Set approval_status = approved;
  :Catat approved_by & approved_at;
  if (Jenis penjualan = Tebak Harga?) then (ya)
    :Inisialisasi siklus tebak harga (scheduled);
  else (normal)
  endif
  :Produk tampil di marketplace;
else (tidak)
  |Admin|
  :Reject + isi alasan;
  |Sistem|
  :Set approval_status = rejected;
  |Penjual|
  :Menerima notifikasi penolakan;
  stop
endif

|Penjual|
:Produk aktif & dapat dibeli pembeli;
stop

@enduml
