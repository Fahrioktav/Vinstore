@startuml Vinstore-UseCase
' =====================================================================
'  USE CASE DIAGRAM - VINSTORE (Marketplace Barang Antik)
'  Konvensi: aktor sisi pengguna di KIRI, aktor pengelola/sistem di KANAN
' =====================================================================
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
title Use Case Diagram - Sistem Vinstore

' ===================== AKTOR SISI KIRI (Pengguna) ===================
actor "Pengunjung\n(Guest)" as Guest
actor "Pembeli\n(User)" as User
actor "Penjual\n(Seller)" as Seller

' Generalisasi sisi pengguna: Penjual & Pembeli adalah turunan Pengunjung
User --|> Guest
Seller --|> User

rectangle "Vinstore" {

  ' ---------------- Publik / Guest ----------------
  usecase "Melihat beranda & katalog produk" as UC_Browse
  usecase "Melihat daftar & detail toko" as UC_Store
  usecase "Melihat daftar & detail lelang" as UC_AuctionView
  usecase "Mengirim pesan kontak" as UC_Contact
  usecase "Registrasi akun" as UC_Register
  usecase "Login (email / Google)" as UC_Login
  usecase "Reset password" as UC_Reset

  ' ---------------- Akun (semua role login) ----------------
  usecase "Mengelola profil" as UC_Profile
  usecase "Logout" as UC_Logout
  usecase "Chat bantuan (realtime)" as UC_Support

  ' ---------------- Pembeli (User) ----------------
  usecase "Mendaftarkan toko" as UC_RegStore
  usecase "Mengelola keranjang" as UC_Cart
  usecase "Checkout & membayar pesanan" as UC_Checkout
  usecase "Mengirim tebakan harga" as UC_Guess
  usecase "Mengikuti lelang (bid)" as UC_Bid
  usecase "Membayar lelang yang dimenangkan" as UC_PayAuction
  usecase "Melihat & membatalkan pesanan" as UC_Orders
  usecase "Mengajukan refund" as UC_Refund
  usecase "Melihat invoice" as UC_Invoice

  ' ---------------- Penjual (Seller) ----------------
  usecase "Mengelola toko" as UC_ManageStore
  usecase "Mengelola produk (CRUD)" as UC_ManageProduct
  usecase "Mengelola lelang (CRUD/relist)" as UC_ManageAuction
  usecase "Mengelola barter antar toko" as UC_Barter
  usecase "Mengelola status pesanan" as UC_OrderStatus
  usecase "Mengajukan pencairan saldo" as UC_Withdraw
  usecase "Melihat dashboard penjual" as UC_SellerDash

  ' ---------------- Validator ----------------
  usecase "Memvalidasi keaslian produk\n(approve/reject)" as UC_Validate

  ' ---------------- Admin ----------------
  usecase "Mengelola pengguna & penjual" as UC_AdminUsers
  usecase "Mengelola toko & kategori" as UC_AdminStores
  usecase "Menyetujui/menolak produk" as UC_AdminProduct
  usecase "Menyetujui/menolak lelang" as UC_AdminAuction
  usecase "Memproses refund" as UC_AdminRefund
  usecase "Memproses pencairan saldo" as UC_AdminWithdraw
  usecase "Mengelola pesan kontak" as UC_AdminContact
  usecase "Melihat dashboard admin" as UC_AdminDash

  ' ---------------- Sistem / Pembayaran ----------------
  usecase "Memproses pembayaran" as UC_Payment
  usecase "Memproses notifikasi pembayaran" as UC_Notif
}

' ===================== AKTOR SISI KANAN (Pengelola/Sistem) ==========
actor "Validator\nBarang Antik" as Validator
actor "Admin" as Admin
actor "Midtrans\n(Payment Gateway)" as Midtrans

' ----------------------- RELASI GUEST (kiri) ------------------------
Guest --> UC_Browse
Guest --> UC_Store
Guest --> UC_AuctionView
Guest --> UC_Contact
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_Reset

' ----------------------- RELASI USER (kiri) -------------------------
User --> UC_Profile
User --> UC_Logout
User --> UC_Support
User --> UC_RegStore
User --> UC_Cart
User --> UC_Checkout
User --> UC_Guess
User --> UC_Bid
User --> UC_PayAuction
User --> UC_Orders
User --> UC_Refund
User --> UC_Invoice

' ----------------------- RELASI SELLER (kiri) -----------------------
Seller --> UC_ManageStore
Seller --> UC_ManageProduct
Seller --> UC_ManageAuction
Seller --> UC_Barter
Seller --> UC_OrderStatus
Seller --> UC_Withdraw
Seller --> UC_SellerDash

' ----------------------- RELASI VALIDATOR (kanan) -------------------
UC_Validate    <-- Validator
UC_Profile     <-- Validator
UC_Support     <-- Validator

' ----------------------- RELASI ADMIN (kanan) ----------------------
UC_AdminUsers    <-- Admin
UC_AdminStores   <-- Admin
UC_AdminProduct  <-- Admin
UC_AdminAuction  <-- Admin
UC_AdminRefund   <-- Admin
UC_AdminWithdraw <-- Admin
UC_AdminContact  <-- Admin
UC_AdminDash     <-- Admin
UC_Profile       <-- Admin
UC_Support       <-- Admin

' ----------------------- RELASI SISTEM (kanan) ---------------------
UC_Payment <-- Midtrans
UC_Notif <-- Midtrans

' ----------------------- RELASI ANTAR USE CASE ---------------------
UC_Checkout ..> UC_Payment : <<include>>
UC_PayAuction ..> UC_Payment : <<include>>
UC_Payment ..> UC_Notif : <<include>>

note right of UC_Validate
  Produk yang diajukan penjual divalidasi
  oleh validator terlebih dahulu sebelum
  masuk ke persetujuan admin.
end note

note right of UC_AdminProduct
  Admin menyetujui atau menolak produk
  yang sudah lolos validasi validator.
end note

@enduml
